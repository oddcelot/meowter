{
  "name": "meowter",
  "version": "0.1.0",
  "description": "Tiny custom-element router built on @solidjs/signals",
  "license": "ISC",
  "bin": {
    "meowter-routes": "./src/codegen/cli.ts"
  },
  "files": [
    "dist",
    "src",
    "meowter.html-data.json",
    "custom-elements.json",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./codegen": {
      "types": "./src/codegen/index.ts",
      "default": "./src/codegen/index.ts"
    },
    "./vite-plugin": {
      "types": "./src/codegen/vite-plugin.ts",
      "default": "./src/codegen/vite-plugin.ts"
    }
  },
  "publishConfig": {
    "bin": {
      "meowter-routes": "./dist/cli.js"
    },
    "main": "./dist/meowter.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/meowter.js"
      },
      "./codegen": {
        "types": "./dist/codegen.d.ts",
        "import": "./dist/codegen.js"
      },
      "./vite-plugin": {
        "types": "./dist/vite-plugin.d.ts",
        "import": "./dist/vite-plugin.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cem:generate": "cem generate src/router-element.ts src/route-element.ts src/outlet-element.ts src/link.ts -o custom-elements.json",
    "cem:watch": "cem generate src/router-element.ts src/route-element.ts src/outlet-element.ts src/link.ts -o custom-elements.json --watch"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@solidjs/signals": "2.0.0-rc.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@solidjs/signals": "^2.0.0-beta.10"
  },
  "engines": {
    "node": ">=26"
  },
  "customElements": "custom-elements.json"
}
